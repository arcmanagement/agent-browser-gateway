{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "0.5.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "homepage_url": "https://agent-browser-gateway.com/",
  "key": "",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "storage",
    "debugger",
    "downloads",
    "alarms",
    "clipboardWrite",
    "tabCapture",
    "desktopCapture",
    "offscreen"
  ],
  "host_permissions": [],
  "optional_permissions": [
    "bookmarks",
    "readingList"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "__MSG_extName__",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "commands": {
    "toggle-share-current-tab": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "__MSG_commandToggleShare__"
    },
    "copy-current-tab-id": {
      "suggested_key": {
        "default": "Alt+Shift+C",
        "mac": "Alt+Shift+C"
      },
      "description": "__MSG_commandCopyTabId__"
    }
  }
}
