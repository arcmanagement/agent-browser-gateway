{
  "manifest_version": 3,
  "name": "Agent Browser Gateway",
  "version": "0.3.7",
  "description": "Share specific Chrome tabs with AI coding agents via per-tab explicit permission.",
  "homepage_url": "https://agent-browser-gateway.com/",
  "key": "",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "storage",
    "debugger",
    "alarms",
    "clipboardWrite"
  ],
  "host_permissions": [],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Agent Browser Gateway",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  }
}
