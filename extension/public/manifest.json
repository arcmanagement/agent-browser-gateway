{
  "manifest_version": 3,
  "name": "Agent Browser Gateway",
  "version": "0.4.5",
  "description": "Share Chrome tabs with AI coding agents via explicit local permission.",
  "homepage_url": "https://agent-browser-gateway.com/",
  "key": "",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "storage",
    "debugger",
    "downloads",
    "alarms",
    "clipboardWrite",
    "tabCapture",
    "desktopCapture",
    "offscreen"
  ],
  "host_permissions": [],
  "optional_permissions": [
    "bookmarks",
    "readingList"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Agent Browser Gateway",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  }
}
