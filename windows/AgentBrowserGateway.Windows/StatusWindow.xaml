<Window
    x:Class="AgentBrowserGateway.Windows.StatusWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Agent Browser Gateway Status">

    <Grid Margin="28" RowSpacing="18" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="6">
            <TextBlock Text="Agent Browser Gateway" FontSize="28" FontWeight="SemiBold" />
            <TextBlock
                x:Name="StateText"
                Text="Checking Gateway..."
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Border Grid.Row="1" Padding="18" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid ColumnSpacing="24" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Spacing="2">
                    <TextBlock Text="Version" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="VersionText" Text="-" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="Gateway" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="GatewayText" Text="-" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Row="1" Spacing="2">
                    <TextBlock Text="Extensions" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="ExtensionText" Text="-" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                    <TextBlock Text="Shared tabs" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="TabsCountText" Text="-" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Spacing="2">
                    <TextBlock Text="Process path" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="ProcessText" Text="-" TextWrapping="Wrap" FontFamily="Consolas" />
                </StackPanel>
                <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Spacing="2">
                    <TextBlock Text="Audit log" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="AuditText" Text="-" TextWrapping="Wrap" FontFamily="Consolas" />
                </StackPanel>
            </Grid>
        </Border>

        <ListView Grid.Row="2" x:Name="TabsList" SelectionMode="None">
            <ListView.Header>
                <TextBlock Text="Shared tabs" FontWeight="SemiBold" />
            </ListView.Header>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnSpacing="12" Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Ref}" FontFamily="Consolas" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Text="{Binding Url}"
                                TextTrimming="CharacterEllipsis"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                FontSize="12" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="Revoke" Click="Revoke_Click" Tag="{Binding TabId}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" x:Name="StartButton" Content="Start Gateway" Click="StartGateway_Click" />
            <Button Grid.Column="2" Content="Open audit log" Click="OpenAuditLog_Click" />
            <Button Grid.Column="3" Content="Open logs folder" Click="OpenLogsFolder_Click" />
            <Button Grid.Column="4" Content="Refresh" Click="Refresh_Click" />
        </Grid>
    </Grid>
</Window>
