<UserControl x:Class="AgentBrowserGateway.Windows.GateMark"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Viewbox AutomationProperties.AccessibilityView="Raw">
        <Canvas Width="20" Height="20">
            <Rectangle x:Name="LeftRail" Canvas.Left="1" Canvas.Top="9.2" Width="5.6" Height="1.6" RadiusX="0.8" RadiusY="0.8" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
            <Rectangle x:Name="RightRail" Canvas.Left="13.4" Canvas.Top="9.2" Width="5.6" Height="1.6" RadiusX="0.8" RadiusY="0.8" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
            <Rectangle x:Name="LeftPillar" Canvas.Left="6.6" Canvas.Top="3" Width="2.3" Height="14" RadiusX="1.15" RadiusY="1.15" Fill="{ThemeResource TextFillColorPrimaryBrush}" />
            <Rectangle x:Name="RightPillar" Canvas.Left="11.1" Canvas.Top="3" Width="2.3" Height="14" RadiusX="1.15" RadiusY="1.15" Fill="{ThemeResource TextFillColorPrimaryBrush}" />
            <Ellipse x:Name="Signal" Canvas.Left="8.5" Canvas.Top="8.5" Width="3" Height="3" Fill="{ThemeResource GateSignal}" Visibility="Collapsed" />
        </Canvas>
    </Viewbox>
</UserControl>
