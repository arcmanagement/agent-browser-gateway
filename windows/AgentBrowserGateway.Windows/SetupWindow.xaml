<Window x:Class="AgentBrowserGateway.Windows.SetupWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:AgentBrowserGateway.Windows" Title="Agent Browser Gateway Setup">
    <Grid x:Name="Root" Background="{ThemeResource GateCanvas}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" HorizontalContentAlignment="Center" SizeChanged="Viewport_SizeChanged">
            <StackPanel x:Name="SetupContent" Margin="32" Spacing="24" MaxWidth="620" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="16"><local:GateMark Width="48" Height="48" /><StackPanel Spacing="4"><TextBlock Text="Agent Browser Gateway" FontSize="26" FontWeight="SemiBold" /><TextBlock x:Name="ModeText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel></StackPanel>
                <StackPanel Spacing="8"><TextBlock Text="Share only what you choose." Tag="Share only what you choose." FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="Install the Gateway, then share a tab from the browser extension." Tag="Install the Gateway, then share a tab from the browser extension." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                <Border Style="{StaticResource GateCardStyle}"><StackPanel Spacing="16">
                    <TextBox x:Name="InstallDirBox" Header="Install location" Tag="Install location" />
                    <CheckBox x:Name="PathCheckBox" Content="Add Agent Browser Gateway to PATH" Tag="Add Agent Browser Gateway to PATH" IsChecked="True" />
                    <CheckBox x:Name="StartCheckBox" Content="Start tray Gateway after install" Tag="Start tray Gateway after install" IsChecked="True" />
                    <CheckBox x:Name="StartupCheckBox" Content="Launch tray Gateway when I sign in" Tag="Launch tray Gateway when I sign in" IsChecked="True" />
                    <TextBlock x:Name="StatusText" Text="Ready" Tag="Ready" TextWrapping="Wrap" />
                    <ProgressBar x:Name="Progress" Minimum="0" Maximum="100" Value="0" />
                </StackPanel></Border>
                <StackPanel Spacing="8"><TextBlock Text="Setup replaces the existing app and applies the options above." Tag="Setup replaces the existing app and applies the options above." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="PayloadText" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right"><Button x:Name="OpenFolderButton" Content="Open install folder" Tag="Open install folder" Click="OpenFolder_Click" /><Button Content="Close" Tag="Close" Click="Close_Click" /><Button x:Name="InstallButton" Content="Install / Update" Tag="Install / Update" Style="{StaticResource GatePrimaryButton}" Click="Install_Click" /></StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
