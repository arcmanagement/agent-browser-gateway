<Window
    x:Class="AgentBrowserGateway.Windows.SetupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Agent Browser Gateway Setup">

    <Grid Margin="28" RowSpacing="20" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="6">
            <TextBlock Text="Agent Browser Gateway" FontSize="28" FontWeight="SemiBold" />
            <TextBlock
                x:Name="ModeText"
                Text="Windows native setup"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Border Grid.Row="1" Padding="18" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBox
                    x:Name="InstallDirBox"
                    Header="Install location"
                    PlaceholderText="C:\Tools\AgentBrowserGateway" />
                <StackPanel Grid.Row="1" Spacing="8">
                    <CheckBox x:Name="PathCheckBox" Content="Add Agent Browser Gateway to PATH" IsChecked="True" />
                    <CheckBox x:Name="StartCheckBox" Content="Start tray Gateway after install" IsChecked="True" />
                    <CheckBox x:Name="StartupCheckBox" Content="Launch tray Gateway when I sign in" IsChecked="True" />
                </StackPanel>
                <StackPanel Grid.Row="2" Spacing="8">
                    <TextBlock x:Name="StatusText" Text="Ready" TextWrapping="Wrap" />
                    <ProgressBar x:Name="Progress" Minimum="0" Maximum="100" Value="0" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Padding="18" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <StackPanel Spacing="10">
                <TextBlock Text="What setup will do" FontWeight="SemiBold" />
                <TextBlock Text="Stop the old Gateway and wait for 127.0.0.1:8765 to become free." TextWrapping="Wrap" />
                <TextBlock Text="Replace installed files from the bundled payload and update PATH if selected." TextWrapping="Wrap" />
                <TextBlock Text="Configure sign-in startup, refresh Claude/Codex skills, and start the tray Gateway if selected." TextWrapping="Wrap" />
                <TextBlock
                    x:Name="PayloadText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" x:Name="OpenFolderButton" Content="Open install folder" Click="OpenFolder_Click" />
            <Button Grid.Column="2" Content="Close" Click="Close_Click" />
            <Button Grid.Column="3" x:Name="InstallButton" Content="Install / Update" Click="Install_Click" />
        </Grid>
    </Grid>
</Window>
