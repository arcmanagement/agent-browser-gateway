---
interface Props {
  text: string;
  label: string;
  copiedLabel: string;
  ariaLabel?: string;
  compact?: boolean;
}
const { text, label, copiedLabel, ariaLabel, compact = false } = Astro.props;
---

<button
  class:list={["copy-btn", { "copy-btn--compact": compact }]}
  type="button"
  data-copy={text}
  data-copied-label={copiedLabel}
  aria-label={ariaLabel ?? `${label}: ${text}`}
>
  <svg class="copy-btn__icon copy-btn__icon--copy" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="8" y="8" width="12" height="12" rx="2.5" /><path d="M16 8V6.5A2.5 2.5 0 0 0 13.5 4h-7A2.5 2.5 0 0 0 4 6.5v7A2.5 2.5 0 0 0 6.5 16H8" /></svg>
  <svg class="copy-btn__icon copy-btn__icon--done" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
  <span class:list={["copy-btn__label", { "sr-only": compact }]} data-copy-label>{label}</span>
</button>
